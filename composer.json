{
    "name": "wordpress/php-mcp-schema",
    "description": "Descriptor-backed PHP records for explicit Model Context Protocol revisions",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "record",
        "schema",
        "php"
    ],
    "homepage": "https://github.com/WordPress/php-mcp-schema",
    "authors": [
        {
            "name": "WordPress",
            "homepage": "https://wordpress.org"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "WP\\McpSchema\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "benchmark": "php benchmarks/generic-record.php",
        "phpstan": "@analyse",
        "demo": "php examples/generic-record.php",
        "test": "php tests/generic-record.php",
        "check": [
            "@test",
            "@analyse"
        ]
    }
}

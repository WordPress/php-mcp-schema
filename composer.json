{
    "name": "wordpress/php-mcp-schema",
    "description": "Exact-revision PHP schema runtime for the Model Context Protocol (MCP)",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "mcp",
        "model-context-protocol",
        "schema",
        "php"
    ],
    "homepage": "https://github.com/WordPress/php-mcp-schema",
    "authors": [
        {
            "name": "WordPress",
            "homepage": "https://wordpress.org"
        }
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "WP\\McpSchema\\Contract\\": "src/Generated/Contract/",
            "WP\\McpSchema\\Generated\\": "src/Generated/",
            "WP\\McpSchema\\Record\\": "src/Generated/Record/",
            "WP\\McpSchema\\Value\\": "src/Generated/Value/",
            "WP\\McpSchema\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "phpstan": "@analyse",
        "test": "phpunit"
    }
}
